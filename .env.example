# Copiar a .env y completar. El .env está en .gitignore y NUNCA se commitea.
# cp .env.example .env

# --- Credencial ---
# API key de Anthropic. Se lee por variable de entorno, nunca hardcodeada.
ANTHROPIC_API_KEY=

# --- Configuración del modelo ---
# Modelo que razona sobre cada caso y propone la acción.
ANTHROPIC_MODEL=claude-opus-5

# Nivel de esfuerzo de razonamiento: low | medium | high | xhigh | max.
# Es la palanca de reproducibilidad y costo de este proyecto (ver ADR-002 en el README):
# los modelos actuales ya no aceptan el parámetro `temperature`.
ANTHROPIC_EFFORT=low
